{
  "name": "@peculiar/certificates-viewer",
  "version": "5.0.0",
  "private": false,
  "description": "Peculiar Certificate Viewer web-components makes it easy for you to display certificate related details in your web application.",
  "keywords": [
    "asn1",
    "certificate",
    "certificate-viewer",
    "certificates-viewer",
    "decoding",
    "pki",
    "web-component",
    "webpki",
    "x509"
  ],
  "homepage": "https://x509.io/",
  "license": "MIT",
  "author": "PeculiarVentures Team",
  "repository": {
    "type": "git",
    "url": "https://github.com/PeculiarVentures/pv-certificates-viewer",
    "directory": "packages/webcomponents"
  },
  "files": [
    "components/",
    "dist/",
    "hydrate/",
    "loader/"
  ],
  "main": "dist/index.cjs.js",
  "module": "dist/index.js",
  "types": "dist/types/interface.d.ts",
  "jsnext:main": "dist/esm/index.js",
  "es2015": "dist/esm/index.js",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "npm run clean && stencil build --docs",
    "dev": "npm run clean && stencil build --dev --watch --serve",
    "generate": "stencil generate",
    "clean": "rimraf dist loader www components",
    "test": "stencil-test --prod --project spec",
    "test:e2e": "stencil-test --prod --project browser",
    "test:e2e.update": "stencil-test --prod --project browser --update"
  },
  "dependencies": {
    "@peculiar/asn1-adobe-acrobat": "^2.9.4",
    "@peculiar/asn1-android": "^2.9.4",
    "@peculiar/asn1-cert-transparency": "^2.9.4",
    "@peculiar/asn1-cms": "^2.9.4",
    "@peculiar/asn1-csr": "^2.9.4",
    "@peculiar/asn1-ecc": "^2.9.4",
    "@peculiar/asn1-lei": "^2.9.4",
    "@peculiar/asn1-mtc": "^2.9.4",
    "@peculiar/asn1-ntqwac": "^2.9.4",
    "@peculiar/asn1-pkcs9": "^2.9.4",
    "@peculiar/asn1-private-key-stmt": "^2.9.4",
    "@peculiar/asn1-rfc8226": "^2.9.4",
    "@peculiar/asn1-rsa": "^2.9.4",
    "@peculiar/asn1-schema": "^2.9.4",
    "@peculiar/asn1-x509": "^2.9.4",
    "@peculiar/asn1-x509-attr": "^2.9.4",
    "@peculiar/asn1-x509-logotype": "^2.9.4",
    "@peculiar/asn1-x509-microsoft": "^2.9.4",
    "@peculiar/asn1-x509-netscape": "^2.9.4",
    "@peculiar/asn1-x509-post-quantum": "^2.9.4",
    "@peculiar/asn1-x509-qualified": "^2.9.4",
    "@peculiar/asn1-x509-qualified-etsi": "^2.9.4",
    "@peculiar/ssh": "^1.1.1",
    "@stencil/core": "^4.45.0",
    "dayjs": "^1.11.20",
    "pvtsutils": "^1.3.6"
  },
  "devDependencies": {
    "@stencil/react-output-target": "^1.6.2",
    "@stencil/sass": "^3.3.3",
    "@stencil/vitest": "^1.15.1",
    "@types/node": "^24.13.3",
    "@vitest/browser-playwright": "^4.0.0",
    "playwright": "^1.63.0",
    "rimraf": "^3.0.2",
    "typescript": "^6.0.0",
    "vitest": "^4.1.11"
  },
  "collection": "dist/collection/collection-manifest.json",
  "collection:main": "dist/collection/index.js",
  "es2017": "dist/esm/index.js"
}
