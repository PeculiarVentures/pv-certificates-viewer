{
  "compilerOptions": {
    "target": "es2023",
    "lib": ["es2023", "DOM"],
    "module": "preserve",
    "moduleResolution": "bundler",
    "types": [],
    // No verbatimModuleSyntax: Stencil generates src/components.ts with
    // `import { type A, type B } from "@peculiar/certificates-viewer"`, which it would
    // keep as a side-effect import of the whole lazy-loader build.
    "isolatedModules": true,
    "strict": true,
    "skipLibCheck": true,
    "noImplicitOverride": true,
    "noErrorTruncation": true,
    "noEmit": true
  },
  "include": ["src", "*.config.ts"]
}
