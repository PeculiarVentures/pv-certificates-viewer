{
  "name": "peculiar-certificates-viewer-monorepo",
  "version": "5.2.0",
  "private": true,
  "keywords": [
    "asn1",
    "certificate",
    "certificate-viewer",
    "certificates-viewer",
    "decoding",
    "pki",
    "web-component",
    "webpki",
    "x509"
  ],
  "homepage": "https://x509.io/",
  "license": "MIT",
  "author": "PeculiarVentures Team",
  "workspaces": [
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "build": "npm run build --workspace @peculiar/certificates-viewer && tsdown",
    "test": "npm run test --workspaces",
    "typecheck": "tsc -p packages/webcomponents-react",
    "clean": "npm run clean --workspaces --if-present",
    "lint": "OXLINT_TSGOLINT_DANGEROUSLY_SUPPRESS_PROGRAM_DIAGNOSTICS=true oxlint",
    "lint:fix": "npm run lint -- --fix",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "dev": "npm run --workspace @peculiar/certificates-viewer dev",
    "prepare": "npm run build"
  },
  "devDependencies": {
    "@arethetypeswrong/core": "^0.18.5",
    "oxfmt": "^0.70.0",
    "oxlint": "^1.85.0",
    "oxlint-tsgolint": "^7.0.2002",
    "tsdown": "^0.23.3"
  },
  "devEngines": {
    "packageManager": {
      "name": "npm",
      "version": ">=11.7.0",
      "onFail": "warn"
    },
    "runtime": {
      "name": "node",
      "version": ">=24.5.0",
      "onFail": "warn"
    }
  }
}
